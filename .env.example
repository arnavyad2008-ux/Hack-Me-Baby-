# Server-side only. Never prefix these with NEXT_PUBLIC_.

# Live mode (Hugging Face Inference Providers). Without HF_TOKEN, Live mode
# reports a configuration error and Demo mode still works.
# Create a token at https://huggingface.co/settings/tokens (needs "Make calls to Inference Providers").
HF_TOKEN=
# Model and provider routing ("auto" picks the first provider enabled for the model).
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HF_PROVIDER=auto
# Per-request deadline (ms) and retries for 429/5xx/network failures only.
LLM_TIMEOUT_MS=45000
LLM_MAX_RETRIES=2

# Patch execution against the SQLi fixture. "none" (default) never executes patches.
# "docker" runs the harness in a container with no network, read-only fs, 128 MB, 64 pids.
# Pull the image first: docker pull node:24-alpine   (runs use --pull never)
VERIFIER_RUNTIME=none
VERIFIER_IMAGE=node:24-alpine
VERIFIER_TIMEOUT_MS=15000
